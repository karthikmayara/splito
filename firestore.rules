rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    // Checks if logged-in user is a member of the specified group
    function isGroupMember(groupId) {
      return isAuth() && 
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ── Users ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isUser(userId);
    }

    // ── Groups ────────────────────────────────────────────
    // resource.data.members used throughout — no get() needed.
    // Works for both collection queries and single doc reads.
    match /groups/{groupId} {
      // Allow anyone possessing the invite code to read the group overview
      allow get: if true;
      allow list: if true;
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && request.auth.uid in resource.data.members;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ── Expenses ──────────────────────────────────────────
    match /expenses/{expenseId} {
      // Secure check: Evaluates get() against the exact groupId.
      // Works on collection queries because our app always filters by `where('groupId', '==', groupId)`.
      allow read:   if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
                    && request.resource.data.createdBy == request.auth.uid;
      allow update,
      delete:       if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ── Settlements ───────────────────────────────────────
    match /settlements/{settlementId} {
      allow read:   if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId)
                    && (request.resource.data.fromUserId == request.auth.uid || request.resource.data.toUserId == request.auth.uid);
      allow delete: if isAuth() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow update: if false;
    }
  }
}
